# CheeseBase environment configuration example.
# Copy this file to `.env` and fill in your own values when using Hybrid search.
#
# Security note:
# - Never commit `.env` to GitHub.
# - Keep your real API key private.

# ==========================
# Embedding configuration
# ==========================
# Supported value: dashscope
EMBED_MODEL_TYPE=dashscope

# DashScope embedding model. If empty, CheeseBase uses text-embedding-v3.
EMBED_MODEL_NAME=text-embedding-v3

# Your DashScope API key from Alibaba Cloud Bailian / DashScope.
EMBED_API_KEY=your_dashscope_api_key_here

# DashScope OpenAI-compatible endpoint.
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# text-embedding-v3 commonly uses 1024 dimensions in this project.
EMBED_DIMENSIONS=1024

# ==========================
# Qdrant configuration
# ==========================
# Local Qdrant REST endpoint.
QDRANT_URL=http://localhost:6333

# Qdrant collection used by CheeseBase.
QDRANT_COLLECTION=cheesebase_chunks

# Hybrid result threshold, range: 0.0 - 1.0.
# Higher value means fewer but more relevant results.
HYBRID_SCORE_THRESHOLD=0.45
